---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  /** OGP画像のパス(サイトルート基準、例: /og/blog/hello-world.png)。絶対URL化して出力する */
  ogImage?: string;
}

const { title, description = '空間最適化 × AIエージェント開発', ogImage } = Astro.props;

// Astro.site が設定されていれば絶対URLに、なければ相対のまま
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).href : undefined;

// フッターの表題欄(図面のタイトルブロック)に入れるシート名。パスの先頭セグメントから導出
const seg = Astro.url.pathname.split('/').filter(Boolean)[0];
const sheet = seg ? seg.toUpperCase() : 'INDEX';

// コンテンツ本体の遷移。ページ遷移は「たまに見る」ので演出OKだが、デフォルト(0.22s)より
// 速く・強いイージングでキビキビさせる。新ページはわずかに下から入り、旧ページは上へ抜ける。
// prefers-reduced-motion 時は ClientRouter が自動で無効化する。
const contentSwap = {
  forwards: {
    old: { name: 'content-leave', duration: '0.18s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
    new: { name: 'content-enter', duration: '0.28s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
  },
  backwards: {
    old: { name: 'content-leave', duration: '0.18s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
    new: { name: 'content-enter', duration: '0.28s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
  },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- OGP: 画像は astro-og-canvas でビルド時に静的生成(/og/blog/<slug>.png) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <ClientRouter />
  </head>
  <body class="min-h-screen text-ink">
    <header id="site-header" transition:persist class="site-header sticky top-0 z-50">
      <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
        <a
          href="/"
          class="group inline-flex items-center gap-2 rounded-sm font-mono text-sm font-medium tracking-tight transition-colors duration-200 ease-out-strong hover:text-cobalt active:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
        >
          {/* 朱の角印。ワードマークの唯一の色 */}
          <span
            aria-hidden="true"
            class="size-2 bg-shu transition-transform duration-200 ease-out-strong group-hover:rotate-45"
          ></span>
          hyoshihara.dev
        </a>
        <ul class="flex gap-5 font-mono text-xs tracking-widest">
          <li>
            <a
              href="/resume"
              class="rounded-sm text-ink-muted transition-colors duration-200 ease-out-strong hover:text-shu active:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
              >RESUME</a
            >
          </li>
          <li>
            <a
              href="/blog"
              class="rounded-sm text-ink-muted transition-colors duration-200 ease-out-strong hover:text-shu active:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
              >BLOG</a
            >
          </li>
        </ul>
      </nav>
    </header>
    <main transition:animate={contentSwap} class="mx-auto max-w-3xl px-4 py-10">
      <slot />
    </main>
    <!-- フッターは図面の表題欄(タイトルブロック)。PROJECT / SHEET は実情報、SCALE 1:1 はWebの実寸 -->
    <footer class="mx-auto max-w-3xl px-4 pb-10 pt-16">
      <div class="grid grid-cols-3 border border-line bg-surface font-mono text-xs">
        <div class="border-r border-line px-3 py-2.5">
          <div class="text-[10px] tracking-widest text-ink-muted">PROJECT</div>
          <div class="mt-1 text-ink">hyoshihara.dev</div>
        </div>
        <div class="border-r border-line px-3 py-2.5">
          <div class="text-[10px] tracking-widest text-ink-muted">SHEET</div>
          <div class="mt-1 text-ink">{sheet}</div>
        </div>
        <div class="px-3 py-2.5">
          <div class="text-[10px] tracking-widest text-ink-muted">SCALE</div>
          <div class="mt-1 text-ink">1 : 1</div>
        </div>
      </div>
      <p class="mt-3 font-mono text-xs text-ink-muted">© 2026 hyoshihara</p>
    </footer>
    <script>
      // スクロールしてコンテンツがヘッダーに重なったときだけ罫線を出す(scroll edge effect)。
      // ヘッダーは transition:persist で残るため、リスナーの登録は初回の一度だけでよい。
      const header = document.getElementById('site-header');
      const update = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
      update();
      window.addEventListener('scroll', update, { passive: true });
      document.addEventListener('astro:page-load', update);
    </script>
  </body>
</html>
