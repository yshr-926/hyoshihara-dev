---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

interface Props {
  title: string;
  /** og:title。SNS のカードはタブより文脈が少ないので、タブ名と分けたいときに渡す。既定: title */
  ogTitle?: string;
  description?: string;
  /** OGP画像のパス(サイトルート基準、例: /og/blog/hello-world.png)。絶対URL化して出力する */
  ogImage?: string;
  /** OGP 画像の代替説明(og:image:alt / twitter:image:alt)。既定: title */
  ogImageAlt?: string;
  /** og:type。既定 'website'。記事は 'article' */
  ogType?: 'website' | 'article';
  /** <html lang> と、ヘッダー・フッター・スキップリンク・テーマ操作の UI 文言。既定 'ja' */
  lang?: 'ja' | 'en';
  /** 翻訳ページ。渡すと head に hreflang(self + alternate + x-default)を出し、ヘッダーの言語切替もここへ向ける。
   *  渡さないページ(記事など日本語のみ)でも言語切替リンクは消さず、相手言語のトップへ送る */
  alternate?: { lang: 'ja' | 'en'; href: string };
  /** JSON-LD。オブジェクトか配列。<script type="application/ld+json"> で出力 */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** トップページの全幅構成(背景に地図を固定し、本文を左寄せで重ねる)。枠の最大幅を外し、ヘッダーを全幅にする。
   *  フッターは本文と左端を揃え、下端に固定したステータス行のぶん下をあける */
  split?: boolean;
}

// 枠の幅はヘッダー・main・フッターで共通(global.css の --container-site = max-w-site)。
// 記事本文のような読みやすい幅の制御は、各ページが枠の中で行う
const {
  title,
  ogTitle = title,
  description = `${profile.title}。${profile.domain}`,
  ogImage,
  ogImageAlt = ogTitle,
  ogType = 'website',
  lang = 'ja',
  alternate,
  structuredData,
  split = false,
} = Astro.props;

// Astro.site が設定されていれば絶対URLに、なければ相対のまま
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).href : undefined;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// UI 文言。lang で切り替える辞書(ナビ・スキップリンク・テーマ操作)。
// テーマの状態ラベル・読み上げ文言は client 側 script でも同じ形で再定義している(SSR と実行時で lang の扱いが分かれるため)
const UI = {
  ja: {
    skipLink: '本文へ移動',
    navHome: 'プロフィール',
    navPosts: '記事',
    switchTo: { ja: '日本語', en: 'English' },
    themeAriaLabel: '表示テーマを切り替える',
  },
  en: {
    skipLink: 'Skip to content',
    navHome: 'Profile',
    navPosts: 'Posts',
    switchTo: { ja: '日本語', en: 'English' },
    themeAriaLabel: 'Toggle display theme',
  },
} as const;
const t = UI[lang];

// ナビの現在地。/blog/... 配下は「記事」を現在地とする。プロフィール項目の href は言語ごとの自ページ
// (ja: / , en: /en/)を指す。比較前に pathname/href の末尾スラッシュを同じ規則で正規化する
// (trailingSlash: 'ignore' のため URL としてはどちらでも動くが、表記と aria-current 判定を揃える)。
// SSR ではここで aria-current を出し、View Transitions 遷移後は下の script が張り直す
// (ヘッダーは transition:persist で残るため、遷移先の lang に合わせて張り直す必要がある)。
const normalizePath = (path: string) => (path === '/' ? path : path.replace(/\/+$/, ''));
const currentPath = normalizePath(Astro.url.pathname) || '/';
const homeHref = lang === 'en' ? '/en/' : '/';
// ヘッダーの言語切替。翻訳ページがあればそこへ、無ければ相手言語のトップへ(英語版から記事一覧へ移った
// あとも英語版へ戻れるように、リンク自体は常に出す)。hreflang の meta は本当の翻訳があるときだけ(上の alternate)
const otherLang = lang === 'en' ? 'ja' : 'en';
const langSwitch = alternate ?? { lang: otherLang, href: otherLang === 'en' ? '/en/' : '/' };
const isCurrent = (href: string) => {
  const normalizedHref = normalizePath(href) || '/';
  return (
    currentPath === normalizedHref ||
    (normalizedHref !== '/' && currentPath.startsWith(`${normalizedHref}/`))
  );
};
// 「記事」は公開記事があるときだけ出す(0 件の一覧へ案内しない)。記事を公開すると自動で戻る
const hasPosts = (await getCollection('blog', ({ data }) => !data.draft)).length > 0;
const navItems = [
  { href: homeHref, label: t.navHome },
  ...(hasPosts ? [{ href: '/blog', label: t.navPosts }] : []),
];

const year = new Intl.DateTimeFormat('en', { timeZone: 'Asia/Tokyo', year: 'numeric' }).format(
  new Date(),
);

// ページ遷移時のコンテンツ本体の小さなフェード。新ページはわずかに下から入り、旧ページは上へ抜ける。
// prefers-reduced-motion 時は ClientRouter が自動で無効化する。
const contentSwap = {
  forwards: {
    old: { name: 'content-leave', duration: '0.18s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
    new: { name: 'content-enter', duration: '0.28s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
  },
  backwards: {
    old: { name: 'content-leave', duration: '0.18s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
    new: { name: 'content-enter', duration: '0.28s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={profile.siteName} href="/rss.xml" />
    {
      /* hreflang は自己参照 + 相手言語 + x-default(日本語)の 3 本。alternate が無いページには出さない */
      alternate && (
        <>
          <link rel="alternate" hreflang={lang} href={canonicalUrl} />
          <link
            rel="alternate"
            hreflang={alternate.lang}
            href={new URL(alternate.href, Astro.site ?? Astro.url).href}
          />
          <link
            rel="alternate"
            hreflang="x-default"
            href={
              lang === 'ja' ? canonicalUrl : new URL(alternate.href, Astro.site ?? Astro.url).href
            }
          />
        </>
      )
    }
    <!-- OGP: 画像は astro-og-canvas でビルド時に静的生成(/og/blog/<slug>.png) -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {
      /* JSON.stringify は < をエスケープしないので、値に </script> が入っても要素が閉じないよう \u003c にする */
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
        />
      )
    }
    {
      /* テーマの復元は描画前(head内・同期)に行う。body描画後だと一瞬逆のテーマが見える(FOUC)。
        色は light-dark() で解決されるので、:root の color-scheme を固定するだけで全色が切り替わる。
        保存値がなければ color-scheme: light dark のまま OS 設定に追従し、ボタンで選ぶと固定される。
        View Transitions は遷移のたびに <html> の属性を置き換えるため、astro:after-swap で毎回張り直す。 */
    }
    <script is:inline>
      (() => {
        // 保存値が 'light' / 'dark' のときだけ固定する。無ければ auto(delete)= OS 設定に追従
        const apply = () => {
          const stored = localStorage.getItem('theme');
          const root = document.documentElement;
          if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
          else delete root.dataset.theme;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <!-- body は縦の flex。main が余った高さを取るので、短いページでもフッターが画面下端に付く(中途半端な位置に浮かない)。mx-auto は flex アイテムでも auto マージンとして効く -->
  <body class="flex min-h-screen flex-col text-ink">
    {
      /* スキップリンク。キーボードの最初の Tab で現れ、本文(main#main)へ飛ぶ。
        枠はコバルト = 操作の色。朱は「現在地」に取ってあるのでここでは使わない。 */
    }
    <a href="#main" class="skip-link">{t.skipLink}</a>
    {
      /* persist キーに lang を含める: 同じ言語内の遷移(/ → /blog 等)ではヘッダー DOM をそのまま
        使い回し(scroll-edge・テーマの状態を保つ)、言語が変わる遷移(/ ⇄ /en/)では別キー扱いになり
        Astro が遷移先ページの SSR 済みヘッダー(正しいラベル・href・aria-label)に差し替える。
        split(トップの全幅ヘッダー)もキーに含め、トップ ⇄ 記事の遷移で枠の幅が持ち越されないようにする。 */
    }
    <header
      id="site-header"
      transition:persist={`site-header-${lang}${split ? '-split' : ''}`}
      class="site-header sticky top-0 z-50"
    >
      {
        /* 高さは 52px 固定(min-h-13)。中の操作要素は 44px 角の操作領域を持つ(モバイルの指先基準)。
        flex-wrap は極端な文字拡大(200%等)でワードマークとナビが 1 行に収まらないときの折り返し用。
        390px 幅で 1 行に収めるため、〜sm ではナビの「プロフィール」項目を隠し(ワードマークがトップへの
        リンクを兼ねる)、ナビの間隔を 0(各項目の px-2 が間隔を兼ねる)、言語切替を短い表記(EN / JA)にする
        (折り返すと sticky ヘッダーが 88px になり重いため)。ワードマークはドメイン名なので省略しない */
      }
      <nav
        aria-label={lang === 'en' ? 'Main' : 'メイン'}
        class:list={[
          'mx-auto flex min-h-13 flex-wrap items-center justify-between gap-x-2 px-4',
          split ? 'lg:px-6' : 'max-w-site',
        ]}
      >
        <a
          href={homeHref}
          class="group -mx-2 inline-flex min-h-11 items-center gap-2 rounded-sm px-2 font-mono text-sm font-medium tracking-tight transition-colors duration-200 ease-out-strong hover:text-cobalt active:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
        >
          {/* 朱の角印。ワードマークの印 */}
          <span
            aria-hidden="true"
            class="size-2 bg-shu transition-transform duration-200 ease-out-strong group-hover:rotate-45"
          ></span>
          {profile.siteName}
        </a>
        <ul class="flex flex-wrap items-center gap-0 text-sm sm:gap-1">
          {
            /* 操作ラベルは日本語。現在地は文字をインクに戻し、朱の下線を引く(朱 = 現在地の印)。
              aria-current はこのラベル付きナビだけに付け、ワードマークには付けない(WAI-ARIA は
              関連要素の集合で current を 1 要素に限定するのが望ましいため) */
          }
          {
            navItems.map(({ href, label }) => (
              <li class:list={[href === homeHref && 'hidden sm:block']}>
                <a
                  href={href}
                  data-nav
                  data-nav-home={href === homeHref ? 'true' : undefined}
                  aria-current={isCurrent(href) ? 'page' : undefined}
                  class="inline-flex min-h-11 items-center rounded-sm px-2 text-ink-muted underline-offset-[0.45em] transition-colors duration-200 ease-out-strong hover:text-ink active:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-shu aria-[current=page]:decoration-2"
                >
                  {label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={langSwitch.href}
              hreflang={langSwitch.lang}
              aria-label={t.switchTo[langSwitch.lang]}
              class="inline-flex min-h-11 items-center rounded-sm px-2 font-mono text-xs text-ink-muted transition-colors duration-200 ease-out-strong hover:text-ink active:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
            >
              <span aria-hidden="true" class="sm:hidden">
                {langSwitch.lang.toUpperCase()}
              </span>
              <span aria-hidden="true" class="hidden sm:inline">
                {t.switchTo[langSwitch.lang]}
              </span>
            </a>
          </li>
          <li class="-mr-3">
            {
              /* 3 状態(ライト / ダーク / 端末に合わせる)を巡回するトグル。
                アイコン: 太陽=ライト、月=ダーク、半月=端末に合わせる。
                状態は data-mode で持ち、出し分けは末尾の scoped style。即時切替(transition なし)。
                aria-pressed は 3 状態のため使わない。読み上げは aria-label + title + aria-live の sr-only。 */
            }
            <button
              id="theme-toggle"
              type="button"
              aria-label={t.themeAriaLabel}
              class="theme-toggle grid size-11 place-items-center rounded-sm text-ink-muted transition-colors duration-200 ease-out-strong hover:text-ink active:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
            >
              <svg
                class="size-4"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.25"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <g class="theme-toggle__sun">
                  <circle cx="10" cy="10" r="3.5"></circle>
                  <path
                    d="M10 2v2M10 16v2M2 10h2M16 10h2M4.34 4.34l1.42 1.42M14.24 14.24l1.42 1.42M15.66 4.34l-1.42 1.42M5.76 14.24l-1.42 1.42"
                  ></path>
                </g>
                <path
                  class="theme-toggle__moon"
                  d="M15.5 12.4A6.5 6.5 0 0 1 7.6 4.5a6.5 6.5 0 1 0 7.9 7.9Z"></path>
                <g class="theme-toggle__auto">
                  <circle cx="10" cy="10" r="6.5"></circle>
                  <path d="M10 3.5a6.5 6.5 0 0 0 0 13Z" fill="currentColor" stroke="none"></path>
                </g>
              </svg>
            </button>
            <script is:inline>
              // 描画前に現在のテーマをアイコンへ写す(head のスクリプトと同じ判定。保存値がなければ端末=auto)。
              // 下の module script を待つと初回描画でアイコンが一瞬入れ替わる
              (() => {
                const stored = localStorage.getItem('theme');
                const theme = stored === 'light' || stored === 'dark' ? stored : 'auto';
                const button = document.getElementById('theme-toggle');
                button.dataset.mode = theme;
              })();
            </script>
            <span id="theme-status" class="sr-only" aria-live="polite"></span>
          </li>
        </ul>
      </nav>
    </header>
    {
      /* tabindex="-1" はスキップリンクの着地点にするため。マウスクリックでも focus は当たるが
        :focus-visible にならないので枠は出ない。念のため outline も消しておく */
    }
    <main
      id="main"
      tabindex="-1"
      transition:animate={contentSwap}
      class:list={['w-full flex-1 focus:outline-none', !split && 'mx-auto max-w-site px-4 py-10']}
    >
      <slot />
    </main>
    {
      /* フッターは © の 1 行だけ(連絡先はトップの氏名ブロックにあるので重ねない)。
        上の罫線は px-4 の内側(div)に引き、本文・セクション罫線と左右端を揃える */
    }
    <footer
      class:list={[
        split
          ? 'relative px-4 pb-20 sm:px-8 lg:px-[clamp(2.5rem,7vw,7.5rem)] [&>div]:max-w-[40rem]'
          : 'mx-auto w-full max-w-site px-4 pb-10',
      ]}
    >
      <div class="border-t border-line pt-6">
        <p class="font-mono text-xs text-ink-muted">© {year} {profile.fullName}</p>
      </div>
    </footer>
    <script>
      // スクロールしてコンテンツがヘッダーに重なったときだけ罫線を出す(scroll edge effect)。
      // ヘッダーは lang ごとに別 persist キー(id は共通)のため、言語切替で DOM ノードが
      // 差し替わることがある。header 要素は毎回 DOM から引き直す(モジュール変数にキャッシュしない)。
      const update = () => {
        document
          .getElementById('site-header')
          ?.toggleAttribute('data-scrolled', window.scrollY > 8);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      document.addEventListener('astro:page-load', update);

      // ナビの現在地。同じ言語内の遷移(ヘッダー DOM が persist される)では、遷移のたびに
      // URL から張り直す必要がある。対象はラベル付きナビ(プロフィール / 記事)だけで、
      // ワードマークには aria-current を付けない(current は集合内で 1 要素に限定する)。
      // プロフィール項目は data-nav-home で判定する(href は lang ごとに / または /en/ なので、
      // ここでは href 文字列を決め打ちしない)。SSR 側(isCurrent/normalizePath)と同じ規則で
      // 末尾スラッシュを正規化してから比較する。
      const normalizePath = (path: string) => (path === '/' ? path : path.replace(/\/+$/, ''));
      const syncCurrent = () => {
        const path = normalizePath(location.pathname) || '/';
        for (const link of document.querySelectorAll<HTMLAnchorElement>(
          '#site-header a[data-nav]',
        )) {
          const href = normalizePath(link.getAttribute('href') ?? '') || '/';
          const match =
            link.dataset.navHome === 'true'
              ? path === href
              : path === href || path.startsWith(`${href}/`);
          if (match) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        }
      };
      document.addEventListener('astro:after-swap', syncCurrent);
      document.addEventListener('astro:page-load', syncCurrent);

      // 表示テーマの切り替え(即時、演出なし)。テーマ本体(<html data-theme>)は head の
      // インラインスクリプトが描画前に張るので、ここは巡回・保存とアイコン/読み上げの同期だけ。
      // 3 状態(ライト → ダーク → 端末に合わせる → …)を巡回する。「端末に合わせる」は保存値を消して OS 追従に戻す。
      type Theme = 'light' | 'dark' | 'auto';
      const root = document.documentElement;
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

      const THEME_LABEL: Record<'ja' | 'en', Record<Theme, string>> = {
        ja: { light: 'ライト', dark: 'ダーク', auto: '端末に合わせる' },
        en: { light: 'Light', dark: 'Dark', auto: 'Match device' },
      };
      const STATUS_TEXT: Record<'ja' | 'en', (label: string) => string> = {
        ja: (label) => `表示テーマを${label}にしました`,
        en: (label) => `Display theme set to ${label}`,
      };
      // 言語が変わる遷移ではヘッダー DOM が差し替わり <html lang> も変わるため、
      // 使うたびに読み直す(モジュール読み込み時の一度きりの値にしない)。
      const uiLang = (): 'ja' | 'en' => (root.lang === 'en' ? 'en' : 'ja');

      // ボタンは毎回 DOM から引き直す(遷移をまたいで同じノードである保証はないため)
      const themeButton = () => document.getElementById('theme-toggle');
      const themeStatus = () => document.getElementById('theme-status');

      // 保存値が無ければ 'auto'(見た目は OS 設定に追従した状態)
      const currentTheme = (): Theme => {
        const stored = root.dataset.theme;
        return stored === 'light' || stored === 'dark' ? stored : 'auto';
      };

      const NEXT_THEME: Record<Theme, Theme> = { light: 'dark', dark: 'auto', auto: 'light' };

      // アイコン(data-mode)を現在のテーマに合わせる
      const syncToggle = () => {
        const button = themeButton();
        if (!button) return;
        const lang = uiLang();
        const theme = currentTheme();
        const label = THEME_LABEL[lang][theme];
        button.dataset.mode = theme;
        button.title = `${lang === 'en' ? 'Display theme: ' : '表示テーマ: '}${label}`;
      };
      syncToggle();

      const applyTheme = (theme: Theme) => {
        if (theme === 'auto') {
          delete root.dataset.theme;
          localStorage.removeItem('theme');
        } else {
          root.dataset.theme = theme;
          localStorage.setItem('theme', theme);
        }
        syncToggle();
        const lang = uiLang();
        const status = themeStatus();
        if (status) status.textContent = STATUS_TEXT[lang](THEME_LABEL[lang][theme]);
      };

      // クリックは document 側で受ける(委譲)。ボタンが差し替わってもリスナーが外れない
      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Element)) return;
        if (!e.target.closest('#theme-toggle')) return;
        applyTheme(NEXT_THEME[currentTheme()]);
      });

      // 遷移後は <html> の属性が張り直された直後なので、アイコンも合わせ直す
      document.addEventListener('astro:after-swap', syncToggle);
      document.addEventListener('astro:page-load', syncToggle);
      // 「端末に合わせる」のあいだは、OS 側の変更にアイコンを追従させる(見た目は color-scheme が自動で切り替える)
      prefersDark.addEventListener('change', syncToggle);
    </script>
  </body>
</html>

