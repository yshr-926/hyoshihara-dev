---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** OGP画像のパス(サイトルート基準、例: /og/blog/hello-world.png)。絶対URL化して出力する */
  ogImage?: string;
}

const { title, description = '空間最適化 × AIエージェント開発', ogImage } = Astro.props;

// Astro.site が設定されていれば絶対URLに、なければ相対のまま
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).href : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- OGP: 画像は astro-og-canvas でビルド時に静的生成(/og/blog/<slug>.png) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  </head>
  <body class="min-h-screen bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
    <header class="border-b border-neutral-200 dark:border-neutral-800">
      <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
        <a href="/" class="font-bold">hyoshihara.dev</a>
        <ul class="flex gap-4 text-sm">
          <li><a href="/resume" class="hover:underline">Resume</a></li>
          <li><a href="/blog" class="hover:underline">Blog</a></li>
        </ul>
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-10">
      <slot />
    </main>
    <footer class="mx-auto max-w-3xl px-4 py-10 text-sm text-neutral-500">
      © 2026 hyoshihara
    </footer>
  </body>
</html>
