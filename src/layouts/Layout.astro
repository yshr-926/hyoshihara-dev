---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { contacts, profile } from '../data/profile';

interface Props {
  title: string;
  description?: string;
  /** OGP画像のパス(サイトルート基準、例: /og/blog/hello-world.png)。絶対URL化して出力する */
  ogImage?: string;
  /**
   * 本文カラムの幅。'wide'(既定)は max-w-3xl、'reading' は max-w-2xl。
   * 長文の記事本文は 1 行が長すぎると読みにくいので 'reading' を渡す。
   * ヘッダー・フッターの幅は変えない(ページ間で枠が動くと落ち着かない)。
   */
  width?: 'wide' | 'reading';
}

const {
  title,
  description = `${profile.title}。${profile.domain}`,
  ogImage,
  width = 'wide',
} = Astro.props;

// Astro.site が設定されていれば絶対URLに、なければ相対のまま
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).href : undefined;

// ナビの現在地。/blog/... 配下は「記事」を現在地とする。末尾スラッシュの有無は区別しない
// (trailingSlash: 'ignore' のため)。SSR ではここで aria-current を出し、
// View Transitions 遷移後は下の script が張り直す(ヘッダーは transition:persist で残るため)。
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
const navItems = [{ href: '/blog', label: '記事' }];

// フッターの連絡先は src/data/profile.ts の contacts を使う(トップと二重管理しない)。
// 別タブでは開かない(採用担当がタブを見失う)。rel="me" は同一人物のプロフィールである宣言(メールには付けない)
const year = new Intl.DateTimeFormat('en', { timeZone: 'Asia/Tokyo', year: 'numeric' }).format(
  new Date(),
);

// ページ遷移時のコンテンツ本体の小さなフェード。新ページはわずかに下から入り、旧ページは上へ抜ける。
// prefers-reduced-motion 時は ClientRouter が自動で無効化する。
const contentSwap = {
  forwards: {
    old: { name: 'content-leave', duration: '0.18s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
    new: { name: 'content-enter', duration: '0.28s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
  },
  backwards: {
    old: { name: 'content-leave', duration: '0.18s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
    new: { name: 'content-enter', duration: '0.28s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
  },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- OGP: 画像は astro-og-canvas でビルド時に静的生成(/og/blog/<slug>.png) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {
      /* テーマの復元は描画前(head内・同期)に行う。body描画後だと一瞬逆のテーマが見える(FOUC)。
        色は light-dark() で解決されるので、:root の color-scheme を固定するだけで全色が切り替わる。
        保存値がなければ color-scheme: light dark のまま OS 設定に追従し、ボタンで選ぶと固定される。
        View Transitions は遷移のたびに <html> の属性を置き換えるため、astro:after-swap で毎回張り直す。 */
    }
    <script is:inline>
      (() => {
        const apply = () => {
          const stored = localStorage.getItem('theme');
          const root = document.documentElement;
          if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
          else delete root.dataset.theme;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen text-ink">
    {
      /* スキップリンク。キーボードの最初の Tab で現れ、本文(main#main)へ飛ぶ。
        枠はコバルト = 操作の色。朱は「現在地」に取ってあるのでここでは使わない。 */
    }
    <a href="#main" class="skip-link">本文へ移動</a>
    <header id="site-header" transition:persist class="site-header sticky top-0 z-50">
      {/* 高さは 52px 固定(min-h-13)。中の操作要素は 44px 角の操作領域を持つ(モバイルの指先基準) */}
      <nav
        aria-label="メイン"
        class="mx-auto flex min-h-13 max-w-3xl items-center justify-between px-4"
      >
        <a
          href="/"
          data-nav
          aria-current={isCurrent('/') ? 'page' : undefined}
          class="group -mx-2 inline-flex min-h-11 items-center gap-2 rounded-sm px-2 font-mono text-sm font-medium tracking-tight transition-colors duration-200 ease-out-strong hover:text-cobalt active:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
        >
          {/* 朱の角印。ワードマークの印 */}
          <span
            aria-hidden="true"
            class="size-2 bg-shu transition-transform duration-200 ease-out-strong group-hover:rotate-45"
          ></span>
          hyoshihara.dev
        </a>
        <ul class="flex items-center gap-1 text-sm">
          {/* 操作ラベルは日本語。現在地は文字をインクに戻し、朱の下線を引く(朱 = 現在地の印) */}
          {
            navItems.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  data-nav
                  aria-current={isCurrent(href) ? 'page' : undefined}
                  class="inline-flex min-h-11 items-center rounded-sm px-2 text-ink-muted underline-offset-[0.45em] transition-colors duration-200 ease-out-strong hover:text-ink active:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-shu aria-[current=page]:decoration-2"
                >
                  {label}
                </a>
              </li>
            ))
          }
          <li class="-mr-3">
            {
              /* ライト / ダークの 2 値トグル。アイコン: 太陽=ライト、月=ダーク。
                状態は data-mode で持ち、出し分けは末尾の scoped style。
                aria-pressed="true" が「ダークが入っている」の意味。読み上げは aria-label + aria-live の sr-only。 */
            }
            <button
              id="theme-toggle"
              type="button"
              aria-label="ダークモード"
              aria-pressed="false"
              class="theme-toggle grid size-11 place-items-center rounded-sm text-ink-muted transition-[color,transform] duration-200 ease-out-strong hover:text-ink active:scale-95 active:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
            >
              <svg
                class="size-4"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.25"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <g class="theme-toggle__sun">
                  <circle cx="10" cy="10" r="3.5"></circle>
                  <path
                    d="M10 2v2M10 16v2M2 10h2M16 10h2M4.34 4.34l1.42 1.42M14.24 14.24l1.42 1.42M15.66 4.34l-1.42 1.42M5.76 14.24l-1.42 1.42"
                  ></path>
                </g>
                <path
                  class="theme-toggle__moon"
                  d="M15.5 12.4A6.5 6.5 0 0 1 7.6 4.5a6.5 6.5 0 1 0 7.9 7.9Z"></path>
              </svg>
            </button>
            <script is:inline>
              // 描画前に現在のテーマをアイコンへ写す(head のスクリプトと同じ判定。保存値がなければ OS 設定)。
              // 下の module script を待つと初回描画でアイコンが一瞬入れ替わる
              (() => {
                const stored = localStorage.getItem('theme');
                const theme =
                  stored === 'light' || stored === 'dark'
                    ? stored
                    : matchMedia('(prefers-color-scheme: dark)').matches
                      ? 'dark'
                      : 'light';
                const button = document.getElementById('theme-toggle');
                button.dataset.mode = theme;
                button.setAttribute('aria-pressed', String(theme === 'dark'));
              })();
            </script>
            <span id="theme-status" class="sr-only" aria-live="polite"></span>
          </li>
        </ul>
      </nav>
    </header>
    {
      /* tabindex="-1" はスキップリンクの着地点にするため。マウスクリックでも focus は当たるが
        :focus-visible にならないので枠は出ない。念のため outline も消しておく */
    }
    <main
      id="main"
      tabindex="-1"
      transition:animate={contentSwap}
      class:list={[
        'mx-auto px-4 py-10 focus:outline-none',
        width === 'reading' ? 'max-w-2xl' : 'max-w-3xl',
      ]}
    >
      <slot />
    </main>
    {
      /* フッターは 2 行: 連絡先のテキストリンクと ©。
        各リンクは 44px 角以上の操作領域(min-h-11 min-w-11 + 横 padding)。
        横 padding ぶんはリストの負マージンで相殺し、先頭の文字位置を本文と揃える */
    }
    <footer class="mx-auto max-w-3xl border-t border-line px-4 pb-10 pt-6 text-sm">
      <ul class="-mx-2 flex flex-wrap gap-x-1">
        {
          contacts.map(({ label, href }) => (
            <li>
              <a
                href={href}
                rel="me noopener"
                class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm px-2 text-cobalt underline decoration-cobalt/40 underline-offset-4 transition-colors duration-200 ease-out-strong hover:text-ink hover:decoration-current active:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-2 font-mono text-xs text-ink-muted">© {year} {profile.handle}</p>
    </footer>
    <script>
      // スクロールしてコンテンツがヘッダーに重なったときだけ罫線を出す(scroll edge effect)。
      // ヘッダーは transition:persist で残るため、リスナーの登録は初回の一度だけでよい。
      const header = document.getElementById('site-header');
      const update = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
      update();
      window.addEventListener('scroll', update, { passive: true });
      document.addEventListener('astro:page-load', update);

      // ナビの現在地。ヘッダーは persist するので、遷移のたびに URL から張り直す。
      // 判定は SSR 側(isCurrent)と同じ: 末尾スラッシュを無視し、配下のパスも現在地に含める
      const syncCurrent = () => {
        const path = location.pathname.replace(/\/+$/, '') || '/';
        for (const link of document.querySelectorAll<HTMLAnchorElement>(
          '#site-header a[data-nav]',
        )) {
          const href = link.getAttribute('href') ?? '';
          const match = href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
          if (match) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        }
      };
      document.addEventListener('astro:after-swap', syncCurrent);
      document.addEventListener('astro:page-load', syncCurrent);

      // 表示テーマの切り替え(即時、演出なし)。テーマ本体(<html data-theme>)は head の
      // インラインスクリプトが描画前に張るので、ここは反転・保存とアイコン/読み上げの同期だけ。
      // 選択肢はライト / ダークの 2 つ。保存値が無いあいだは OS 設定を現在のテーマとみなす。
      type Theme = 'light' | 'dark';
      const root = document.documentElement;
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

      // ボタンは毎回 DOM から引き直す(遷移をまたいで同じノードである保証はないため)
      const themeButton = () => document.getElementById('theme-toggle');
      const themeStatus = () => document.getElementById('theme-status');

      const currentTheme = (): Theme => {
        const t = root.dataset.theme;
        if (t === 'light' || t === 'dark') return t;
        return prefersDark.matches ? 'dark' : 'light';
      };

      const THEME_LABEL: Record<Theme, string> = { light: 'ライト', dark: 'ダーク' };

      // アイコン(data-mode)と押下状態(aria-pressed)を現在のテーマに合わせる
      const syncToggle = () => {
        const button = themeButton();
        if (!button) return;
        const theme = currentTheme();
        button.dataset.mode = theme;
        button.setAttribute('aria-pressed', String(theme === 'dark'));
        button.title = `表示テーマ: ${THEME_LABEL[theme]}`;
      };
      syncToggle();

      const applyTheme = (theme: Theme) => {
        root.dataset.theme = theme;
        localStorage.setItem('theme', theme);
        syncToggle();
        const status = themeStatus();
        if (status) status.textContent = `表示テーマを${THEME_LABEL[theme]}にしました`;
      };

      // クリックは document 側で受ける(委譲)。ボタンが差し替わってもリスナーが外れない
      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Element)) return;
        if (!e.target.closest('#theme-toggle')) return;
        applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
      });

      // 遷移後は <html> の属性が張り直された直後なので、アイコンも合わせ直す
      document.addEventListener('astro:after-swap', syncToggle);
      document.addEventListener('astro:page-load', syncToggle);
      // 未選択(OS 追従)のあいだは、OS 側の変更にアイコンを追従させる
      prefersDark.addEventListener('change', syncToggle);
    </script>
  </body>
</html>

<style>
  /* スキップリンク。平常時は画面上端の外へ退避し、フォーカスで降りてくる。
     transform/opacity のみ。global.css の reduced-motion 一括ルールが transition を止める */
  .skip-link {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 60;
    padding: 0.75rem 1rem;
    border-radius: 0.125rem;
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: 0.875rem;
    line-height: 1.25rem;
    box-shadow:
      0 0 0 2px var(--color-cobalt),
      0 8px 24px rgb(0 0 0 / 0.16);
    opacity: 0;
    transform: translateY(calc(-100% - 1.5rem));
    transition:
      transform 200ms var(--ease-out-strong),
      opacity 200ms var(--ease-out-strong);
  }
  .skip-link:focus-visible {
    outline: none;
    opacity: 1;
    transform: none;
  }

  /* テーマボタンのアイコン出し分け。退く図形は縮んで回りながら消え、入る図形は逆から現れる。
     transform/opacity のみ。状態はボタンの data-mode(light / dark)。
     data-mode が付く前(SSR 直後)は太陽を出しておく。ここが一次定義(global.css には置かない)。 */
  .theme-toggle svg > * {
    transform-origin: center;
    transition:
      opacity 200ms var(--ease-out-strong),
      transform 300ms var(--ease-out-strong);
  }
  .theme-toggle .theme-toggle__moon {
    opacity: 0;
    transform: rotate(-60deg) scale(0.6);
  }
  .theme-toggle[data-mode='dark'] .theme-toggle__sun {
    opacity: 0;
    transform: rotate(60deg) scale(0.6);
  }
  .theme-toggle[data-mode='dark'] .theme-toggle__moon {
    opacity: 1;
    transform: none;
  }
  /* 動きを減らす設定では回転・スケールをやめてフェードだけ残す
     (どの設定かは色ではなく形で判別するので、opacity は必ず残す) */
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle .theme-toggle__moon,
    .theme-toggle[data-mode='dark'] .theme-toggle__sun {
      transform: none;
    }
  }

  /* 高コントラスト設定ではフッターの罫線をはっきりさせる(line トークンは半透明のため) */
  @media (prefers-contrast: more) {
    footer {
      border-top-color: currentColor;
    }
  }
</style>
