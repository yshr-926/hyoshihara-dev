---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/blog/PostCard.astro';

// 下書き(draft: true)は常に除外し、日付の降順で並べる
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  title="記事 — hyoshihara"
  description="探索・最適化アルゴリズムと RAG・LLM 評価に関する技術記事"
>
  <header class="mt-4 sm:mt-8">
    <p class="label-mono" aria-hidden="true">BLOG</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">記事</h1>
    <p class="mt-3 text-sm leading-list text-ink-muted">
      探索・最適化アルゴリズムと RAG・LLM 評価について書いています。
    </p>
  </header>

  <section aria-label="記事一覧" class="mt-10">
    {
      posts.length > 0 ? (
        <ul class="space-y-4">
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm leading-list text-ink-muted">公開記事はまだありません。</p>
      )
    }
  </section>
</Layout>
