---
import Layout from '../layouts/Layout.astro';

// コンテンツの出典: docs/content-input.md 2章(レジュメ)
// 社内固有名は伏せ、「何を解決したか」ベースで記述する(draft.md 3.2)

const profile = [
  { label: 'ROLE', value: 'AIエンジニア' },
  { label: 'BASE', value: '東京' },
  { label: 'STATUS', value: '正社員' },
];

const career = [
  {
    company: 'HEROZ株式会社',
    role: 'AIエンジニア',
    from: { iso: '2025-04', text: '2025.04' },
    to: '現在',
    works: [
      '大手ハウスメーカー向け戸建住宅の自動設計システムで、建築法規(採光・斜線・建ぺい率等)に準拠した間取りの自動生成〜詳細設計〜施工図(DXF/PDF)出力を担当。制約充足・多目的スコアリングによる候補絞り込みを実装',
      '製造業向けCAD製品のマニュアルを自然言語で検索・質問できるRAGアシスタントのPoCを単独で設計・実装。PDFのMarkdown化からLLM-as-a-Judgeによる回答品質の自動評価、Web UIまでを一気通貫で構築',
    ],
    results: [
      '間取り生成・詳細設計・施工図出力の担当領域 約9万行(8ヶ月)',
      '22種類のLLMを4次元・6点満点で横断評価し、モデル選定を主観から定量比較へ転換',
    ],
    tech: [
      'Python',
      '組合せ探索・制約充足',
      '多目的スコアリング',
      '計算幾何',
      'グラフ理論',
      'RAG',
      'LLMオーケストレーション',
      'LLM-as-a-Judge(評価指標設計)',
    ],
  },
];

const skills = [
  { label: '言語', items: 'Python / Rust / TypeScript' },
  {
    label: 'フレームワーク・ライブラリ',
    items:
      'shapely / networkx / numpy / Pydantic / pandas / Gradio / PyPDF2 / ezdxf / pytest / Next.js',
  },
  {
    label: '探索・最適化',
    items:
      '組合せ探索(候補列挙・枝刈り) / 制約充足 / 多目的スコアリング / 焼きなまし法・遺伝的アルゴリズム / グラフ連結性判定 / 計算幾何(ポリゴン演算・座標系変換) / マスクベース形状処理',
  },
  {
    label: 'LLM / RAG',
    items:
      'RAG / LLMオーケストレーション / LLM-as-a-Judge / RAG評価手法・評価指標設計 / プロンプトエンジニアリング / チャンキング戦略 / ドキュメントインテリジェンス(PDF→Markdown化) / ファインチューニング',
  },
  { label: '機械学習・深層学習', items: 'ニューラルネットワーク / 最適化アルゴリズム' },
  {
    label: 'システム設計',
    items:
      'パイプラインの決定性・再現性設計 / 冪等性・リトライ設計 / レート制限下のバッチ処理 / 宣言的ルール判定による自動評価',
  },
  { label: 'インフラ・開発環境', items: 'Docker / uv / Ruff / pytest(CI)' },
  {
    label: 'ドメイン知識',
    items: 'レイアウト最適化(住宅間取り・建築法規〈採光・斜線・建ぺい率等〉) / 製造業向けCAD',
  },
];

const education = [
  { year: '2025', name: '九州工業大学大学院情報工学府', note: '修了' },
  { year: '2023', name: '九州工業大学情報工学部', note: '卒業' },
];
---

<Layout
  title="Resume — hyoshihara"
  description="Hiroto Yoshihara(AIエンジニア)の職務経歴とスキルセット。探索・最適化アルゴリズムとLLM活用(RAG・評価基盤)"
>
  <!-- 冒頭は図面の表題欄(タイトルブロック)。フッターの表題欄と対になる -->
  <header class="mt-4 sm:mt-8">
    <p class="font-mono text-xs tracking-widest text-ink-muted">RESUME</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Hiroto Yoshihara</h1>
    <dl class="mt-8 grid grid-cols-3 border border-line bg-surface font-mono text-xs">
      {
        profile.map((item, i) => (
          <div class:list={['px-3 py-2.5', i < profile.length - 1 && 'border-r border-line']}>
            <dt class="text-[10px] tracking-widest text-ink-muted">{item.label}</dt>
            <dd class="mt-1 text-ink">{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </header>

  <!-- 職務経歴 -->
  <section aria-labelledby="career" class="mt-16">
    <div class="relative mb-8 border-b border-line pb-2">
      <p class="font-mono text-[10px] tracking-widest text-ink-muted">CAREER</p>
      <h2 id="career" class="mt-0.5 text-xl font-semibold tracking-tight">職務経歴</h2>
      {/* 下罫線の左端だけ朱(記事タイトルと同じモチーフ) */}
      <span aria-hidden="true" class="absolute -bottom-px left-0 h-px w-10 bg-shu"></span>
    </div>

    <div class="space-y-12">
      {
        career.map((job) => (
          <article>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-lg font-semibold tracking-tight">{job.company}</h3>
              <p class="font-mono text-xs text-ink-muted">
                <time datetime={job.from.iso}>{job.from.text}</time> — {job.to}
              </p>
            </div>
            <p class="mt-1 text-sm text-ink-muted">{job.role}</p>

            <ul class="mt-5 space-y-3">
              {job.works.map((work) => (
                <li class="flex gap-3 leading-relaxed">
                  {/* 行頭マーカーは方眼に置いたブロック(角印と同形) */}
                  <span aria-hidden="true" class="mt-[0.6em] size-1.5 shrink-0 bg-cobalt/70" />
                  <span>{work}</span>
                </li>
              ))}
            </ul>

            {/* 成果の数字は方眼上の白いシートに載せる(ブログカードと同じモチーフ) */}
            <div class="mt-6 border border-line bg-surface px-4 py-3">
              <p class="font-mono text-[10px] tracking-widest text-ink-muted">RESULTS</p>
              <ul class="mt-2 space-y-1.5 text-sm leading-relaxed">
                {job.results.map((result) => (
                  <li>{result}</li>
                ))}
              </ul>
            </div>

            <p class="mt-4 font-mono text-xs leading-relaxed text-ink-muted">
              {job.tech.join(' / ')}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- スキルセット: 図面の仕上表(スケジュール表)に見立てた罫線テーブル -->
  <section aria-labelledby="skills" class="mt-16">
    <div class="relative mb-6 border-b border-line pb-2">
      <p class="font-mono text-[10px] tracking-widest text-ink-muted">SKILLS</p>
      <h2 id="skills" class="mt-0.5 text-xl font-semibold tracking-tight">スキルセット</h2>
      <span aria-hidden="true" class="absolute -bottom-px left-0 h-px w-10 bg-shu"></span>
    </div>

    <dl>
      {
        skills.map((row) => (
          <div class="grid gap-1 border-b border-line py-3.5 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <dt class="text-xs font-medium tracking-wide text-ink-muted sm:pt-1">{row.label}</dt>
            <dd class="text-sm leading-relaxed">{row.items}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- 学歴 -->
  <section aria-labelledby="education" class="mt-16">
    <div class="relative mb-6 border-b border-line pb-2">
      <p class="font-mono text-[10px] tracking-widest text-ink-muted">EDUCATION</p>
      <h2 id="education" class="mt-0.5 text-xl font-semibold tracking-tight">学歴</h2>
      <span aria-hidden="true" class="absolute -bottom-px left-0 h-px w-10 bg-shu"></span>
    </div>

    <ul class="space-y-3">
      {
        education.map((item) => (
          <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <time datetime={item.year} class="font-mono text-xs text-ink-muted">
              {item.year}
            </time>
            <span class="font-medium">{item.name}</span>
            <span class="text-sm text-ink-muted">{item.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* TODO(任意・後回し可): PDF版ダウンロードリンク(draft.md 3.2) */}
</Layout>
