---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// 最新記事(公開分)を新しい順に3件
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title="hyoshihara — 空間最適化 × AIエージェント開発">
  <!-- ファーストビュー: 10秒で「何者か」が伝わることを最優先(draft.md 3.1) -->
  <section class="mb-20 mt-4 sm:mt-8">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-md">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">hyoshihara</h1>
        <p class="mt-4 text-lg text-ink-muted">
          空間最適化 <span class="font-mono font-medium text-shu">×</span> AIエージェント開発
        </p>
        <p class="mt-5 leading-relaxed">
          {/* TODO: 代表実績ダイジェスト(2〜3件)・連絡先を実装フェーズで作り込む */}
          「どこに・何を・どう置くか」。配置・経路・レイアウトの問題を数理最適化で解き、 AIエージェントとして現場で動くところまで実装しています。
        </p>
        <div class="mt-8 flex items-center gap-5">
          <a
            href="/resume"
            class="group inline-flex items-center gap-1.5 border border-ink px-4 py-2 text-sm font-medium transition-colors duration-200 ease-out-strong hover:bg-ink hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
          >
            経歴を見る
            <span
              aria-hidden="true"
              class="transition-transform duration-200 ease-out-strong group-hover:translate-x-0.5"
              >→</span
            >
          </a>
          <a
            href="/blog"
            class="group inline-flex items-center gap-1 rounded-sm text-sm font-medium text-cobalt transition-colors duration-200 ease-out-strong hover:text-shu focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
          >
            記事を読む
            <span
              aria-hidden="true"
              class="transition-transform duration-200 ease-out-strong group-hover:translate-x-0.5"
              >→</span
            >
          </a>
        </div>
      </div>

      <!-- FIG. 1: ビンパッキングが最適解に収束する図。専門領域(空間最適化)をそのまま絵にする。
           各ブロックは盤面外(--dx/--dy)からスライドインし、無駄0%で敷き詰まる。
           最後のピース(朱)が収まったあと注記がフェードイン。 -->
      <figure class="mx-auto shrink-0 sm:mx-0">
        <svg
          width="240"
          height="192"
          viewBox="0 0 240 192"
          fill="none"
          role="img"
          aria-label="ビンパッキング問題の最適解の図。5つの矩形が容器に無駄なく敷き詰められている"
        >
          <!-- 容器 -->
          <rect
            x="23.5"
            y="23.5"
            width="193"
            height="145"
            class="stroke-ink-muted"
            stroke-width="1.5"></rect>
          <!-- ブロック: 完全充填になる配置。fill はコバルト系の濃淡、最後の1個だけ朱 -->
          <g class="stroke-ink" stroke-opacity="0.25">
            <rect
              class="fig-block fill-cobalt"
              fill-opacity="0.16"
              style="--dx:-48px"
              x="24"
              y="24"
              width="96"
              height="72"></rect>
            <rect
              class="fig-block fill-cobalt"
              fill-opacity="0.28"
              style="--dy:-44px; animation-delay:0.12s"
              x="120"
              y="24"
              width="96"
              height="72"></rect>
            <rect
              class="fig-block fill-cobalt"
              fill-opacity="0.1"
              style="--dy:44px; animation-delay:0.24s"
              x="24"
              y="96"
              width="72"
              height="72"></rect>
            <rect
              class="fig-block fill-cobalt"
              fill-opacity="0.22"
              style="--dx:-48px; --dy:44px; animation-delay:0.38s"
              x="96"
              y="96"
              width="72"
              height="72"></rect>
            <rect
              class="fig-block fill-shu"
              fill-opacity="0.85"
              style="--dx:56px; animation-delay:0.56s"
              x="168"
              y="96"
              width="48"
              height="72"></rect>
          </g>
          <!-- 注記(朱書き)。最後のピースが収まってから現れる -->
          <text
            x="216"
            y="184"
            text-anchor="end"
            class="fig-note fill-shu font-mono"
            font-size="10"
            letter-spacing="0.08em"
          >
            waste = 0%
          </text>
        </svg>
        <figcaption class="mt-2 font-mono text-[10px] tracking-widest text-ink-muted">
          FIG. 1 — BIN PACKING
        </figcaption>
      </figure>
    </div>
  </section>

  <section>
    <div class="mb-4 flex items-baseline justify-between border-b border-line pb-2">
      <h2 class="text-xl font-semibold tracking-tight">最新記事</h2>
      <a
        href="/blog"
        class="group inline-flex items-center gap-1 rounded-sm font-mono text-xs tracking-widest text-cobalt transition-colors duration-200 ease-out-strong hover:text-shu focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
      >
        ALL POSTS
        <span
          aria-hidden="true"
          class="transition-transform duration-200 ease-out-strong group-hover:translate-x-0.5"
          >→</span
        >
      </a>
    </div>
    <ul class="divide-y divide-line">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group -mx-4 flex items-baseline gap-4 px-4 py-3 transition-[background-color,translate] duration-200 ease-out-strong hover:-translate-y-0.5 hover:bg-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt active:translate-y-0 active:duration-100"
            >
              <span class="shrink-0 font-mono text-xs text-ink-muted">
                {post.data.date.toISOString().slice(0, 10)}
              </span>
              <span
                transition:name={`post-title-${post.id}`}
                class="font-medium decoration-shu/50 underline-offset-4 group-hover:underline"
              >
                {post.data.title}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
