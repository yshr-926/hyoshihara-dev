---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DescentHome from '../components/descent/DescentHome.astro';
import { career, contacts, education, fieldGroups, languages, profile } from '../data/profile';

// 最新記事(公開分)を新しい順に 3 件。下書き(draft)は常に除外する。0 件なら「記事」セクション自体を出さない
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// 「まず読んでほしい記事」枠: featured な公開記事を新しい順に最大 2 本。0 件ならセクションごと出さない
const featuredPosts = (
  await getCollection('blog', ({ data }) => !data.draft && data.featured === true)
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

// 主連絡先(1 件だけ true)。連絡先リストの先頭に置く(案内文は置かない)
const primaryContact = contacts.find((contact) => contact.primary);
const orderedContacts = primaryContact
  ? [primaryContact, ...contacts.filter((contact) => contact !== primaryContact)]
  : contacts;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: profile.fullName,
    alternateName: profile.fullNameJa,
    jobTitle: profile.title,
    url: new URL('/', Astro.site ?? Astro.url).href,
    sameAs: contacts.map((contact) => contact.href),
  },
};
---

<Layout
  title={profile.siteName}
  ogTitle={`${profile.fullNameJa} / ${profile.fullName} — AIエンジニア`}
  description={`${profile.fullNameJa}(${profile.fullName})の個人サイト。${profile.title}として${profile.domain}に取り組んでいます。経歴・個人開発・技術記事を掲載。`}
  ogImage="/og/site.png"
  ogImageAlt={`${profile.fullNameJa} / ${profile.fullName} — ${profile.title}`}
  alternate={{ lang: 'en', href: '/en/' }}
  structuredData={structuredData}
  split
>
  {/* 和名を主役にし、英名は読みの補助として添える */}
  <DescentHome
    lang="ja"
    name={profile.fullNameJa}
    nameSub={profile.fullName}
    title={profile.title}
    domain={profile.domain}
    intro={profile.intro}
    contacts={orderedContacts}
    affiliation={career[0].company}
    languages={languages}
    fields={fieldGroups}
    career={career.map((job) => ({
      from: job.from,
      to: job.to === '現在' ? null : job.to,
      company: job.company,
      role: job.role,
    }))}
    education={education.map((entry) => ({
      year: entry.year,
      text: `${entry.school} ${entry.status}`,
    }))}
    featured={featuredPosts.map((post) => ({
      href: `/blog/${post.id}`,
      title: post.data.title,
      note: post.data.featuredNote,
    }))}
    posts={posts.map((post) => ({
      href: `/blog/${post.id}`,
      title: post.data.title,
      date: post.data.date,
    }))}
    updatedAt={profile.updatedAt}
  />
</Layout>
