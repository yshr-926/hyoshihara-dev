---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// 最新記事(公開分)を新しい順に3件
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title="hyoshihara — 空間最適化 × AIエージェント開発">
  <!-- ファーストビュー: 10秒で「何者か」が伝わることを最優先(draft.md 3.1) -->
  <section class="mb-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">hyoshihara</h1>
    <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-400">
      空間最適化 × AIエージェント開発
    </p>
    <p class="mt-4 max-w-prose text-neutral-700 dark:text-neutral-300">
      {/* TODO: キャッチコピー・代表実績ダイジェスト(2〜3件)・連絡先を実装フェーズで作り込む */}
      キャッチコピーと代表実績のダイジェストをここに置く。
    </p>
    <div class="mt-6 flex gap-4 text-sm">
      <a href="/resume" class="underline">経歴を見る →</a>
      <a href="/blog" class="underline">記事を読む →</a>
    </div>
  </section>

  <section>
    <h2 class="mb-4 text-xl font-semibold">最新記事</h2>
    <ul class="space-y-4">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="block hover:underline">
            <span class="font-medium">{post.data.title}</span>
            <span class="ml-2 text-sm text-neutral-500">
              {post.data.date.toISOString().slice(0, 10)}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
