---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DescentHome from '../../components/descent/DescentHome.astro';
import {
  careerEn,
  contactsEn,
  educationEn,
  fieldGroupsEn,
  languagesEn,
  profileEn,
} from '../../data/profile.en';
import { profile } from '../../data/profile';

// 最新記事(公開分)を新しい順に 3 件。下書き(draft)は常に除外する。0 件なら「記事」セクション自体を出さない
// 記事本文は日本語のみ(英語版は用意しない)。リンクには "(Japanese)" を添え、hreflang="ja" を付ける
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// 「まず読んでほしい記事」枠: featured な公開記事を新しい順に最大 2 本。0 件ならセクションごと出さない
const featuredPosts = (
  await getCollection('blog', ({ data }) => !data.draft && data.featured === true)
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

// 主連絡先(1 件だけ true)。連絡先リストの先頭に置く(案内文は置かない)
const primaryContact = contactsEn.find((contact) => contact.primary);
const orderedContacts = primaryContact
  ? [primaryContact, ...contactsEn.filter((contact) => contact !== primaryContact)]
  : contactsEn;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: profileEn.fullName,
    alternateName: profileEn.fullNameJa,
    jobTitle: profileEn.title,
    url: new URL('/en/', Astro.site ?? Astro.url).href,
    sameAs: contactsEn.map((contact) => contact.href),
  },
};
---

<Layout
  title={profile.siteName}
  ogTitle={`${profileEn.fullName} — ${profileEn.title}`}
  description={`Personal site of ${profileEn.fullName} (${profileEn.fullNameJa}), ${profileEn.title}. Working on ${profileEn.domainInline}. Career history, projects, and technical articles.`}
  ogImage="/og/site.png"
  ogImageAlt={`${profileEn.fullName} — ${profileEn.title}`}
  lang="en"
  alternate={{ lang: 'ja', href: '/' }}
  structuredData={structuredData}
  split
>
  {
    /* 日本語トップと同じ構成・同じセクション ID。英語読者にとって主たる呼称は英名なので、英名を主役にする */
  }
  <DescentHome
    lang="en"
    name={profileEn.fullName}
    nameSub={profileEn.fullNameJa}
    title={profileEn.title}
    domain={profileEn.domain}
    intro={profileEn.intro}
    contacts={orderedContacts}
    affiliation={careerEn[0].company}
    languages={languagesEn}
    fields={fieldGroupsEn}
    career={careerEn.map((job) => ({
      from: job.from,
      to: job.to === 'Present' ? null : job.to,
      company: job.company,
      role: job.role,
    }))}
    education={educationEn.map((entry) => ({
      year: entry.year,
      text: `${entry.school}, ${entry.status}`,
    }))}
    featured={featuredPosts.map((post) => ({
      href: `/blog/${post.id}`,
      title: post.data.title,
      note: post.data.featuredNote,
    }))}
    posts={posts.map((post) => ({
      href: `/blog/${post.id}`,
      title: post.data.title,
      date: post.data.date,
    }))}
    updatedAt={profileEn.updatedAt}
  />
</Layout>
