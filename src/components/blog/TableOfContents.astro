---
import type { MarkdownHeading } from 'astro';

/**
 * 記事の目次。render(post) の headings から depth 2〜3 だけを拾う。
 * 見た目の切り替え(スマホ: details 折りたたみ / PC: 脇に sticky)は呼び出し側で行い、
 * ここは <nav aria-label="目次"> と入れ子リストだけを出す。
 * 現在地の強調は v1 では行わない。
 */
interface Props {
  headings: MarkdownHeading[];
  /** 見出しラベル(等幅英字)を出すか。details の summary が代わりになる場合は false */
  showLabel?: boolean;
}

const { headings, showLabel = true } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<nav aria-label="目次">
  {
    showLabel && (
      <p class="label-mono mb-2" aria-hidden="true">
        CONTENTS
      </p>
    )
  }
  <ol class="space-y-1.5 text-sm leading-snug">
    {
      items.map((h) => (
        <li class:list={[h.depth === 3 && 'pl-4 text-xs']}>
          <a
            href={`#${h.slug}`}
            class="-my-2 flex min-h-11 items-center py-3 text-ink-muted underline decoration-transparent underline-offset-4 transition-[color,text-decoration-color] duration-200 ease-out-strong hover:text-ink hover:decoration-cobalt/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cobalt"
          >
            {h.text}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
