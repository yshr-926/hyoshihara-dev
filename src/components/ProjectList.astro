---
import { projects } from '../data/projects';

interface Props {
  lang: 'ja' | 'en';
  /** ページ側のリンク共通クラス(タップ領域 44px・下線の色) */
  linkClass: string;
}

const { lang, linkClass } = Astro.props;
---

{/* 名前は公開サイトへのリンク。公開リポジトリがあるものだけ GitHub へのリンクを横に添える */}
<ul class="space-y-4">
  {
    projects.map((project) => (
      <li>
        <div class="flex flex-wrap items-baseline gap-x-3">
          <a href={project.href} class:list={[linkClass, 'font-medium text-ink']}>
            {project.name}
          </a>
          {project.repo && (
            <a href={project.repo} class:list={[linkClass, 'text-xs text-ink-muted']}>
              GitHub
              <span class="sr-only">
                {lang === 'ja' ? `(${project.name} のリポジトリ)` : ` (${project.name} repository)`}
              </span>
            </a>
          )}
        </div>
        <p class="text-sm leading-list text-ink-muted">{project.description[lang]}</p>
        <p class="mt-1 font-mono text-xs text-ink-muted">{project.stack.join(' / ')}</p>
      </li>
    ))
  }
</ul>
